# SpoolStack environment
#
# Copy this file to .env.local for local development, and set the same two
# variables in the Vercel project under Settings, Environment Variables.
# .env.local is gitignored. This example file is not, by design.

# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://fpvmqelajzraqsylmjce.supabase.co

# The PUBLIC key: labelled "anon" on older projects, "publishable" on newer
# ones. Either works. It is safe in the browser because Row Level Security,
# not the key, is what grants access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DO NOT put the service_role / secret key in this file or in any variable
# prefixed NEXT_PUBLIC_. That key bypasses RLS entirely. Nothing in Phase 1
# needs it. When something does (a webhook handler, say), it goes in Vercel's
# environment as SUPABASE_SECRET_KEY and is read only from server code.

# Optional. The public address used for canonical links, the sitemap, robots
# and Open Graph images. Leave it unset: on Vercel the production domain is
# picked up automatically from VERCEL_PROJECT_PRODUCTION_URL, so moving to
# spool-stack.com needs no change here. Set it only to force a different
# address, with the scheme and no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://spool-stack.com

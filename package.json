    "test:presets": "node --experimental-strip-types src/lib/presets.test.ts",
    "test:costing": "node --experimental-strip-types src/lib/costing.test.ts && node --experimental-strip-types src/lib/cost-calculator.test.ts",
    "test:contact": "node --experimental-strip-types src/lib/contact.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
